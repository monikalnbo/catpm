# stringx 0.3.0 — string utilities (pure CatBase)
STRINGX_VERSION: str = "0.3.0"

def shout(s: str) -> str {
    return s.upper() + "!"
}

def pad_center(s: str, width: int, fillc: str) -> str {
    return s.center(width, fillc)
}

def words(s: str) -> list[str] {
    out: list[str] = []
    parts: list[str] = s.split(" ")
    i: int = 0
    while i < len(parts) {
        p: str = parts[i].strip()
        if p != "" {
            out.append(p)
        }
        i = i + 1
    }
    return out
}

def reverse(s: str) -> str {
    out: str = ""
    i: int = len(s) - 1
    while i >= 0 {
        out = out + s[i:i+1]
        i = i - 1
    }
    return out
}

def is_palindrome(s: str) -> bool {
    return s == reverse(s)
}
