# fmtx 0.1.0 — formatting helpers; shares stringx with mathx (diamond shape)
import ../stringx/index.catc as stringx

FMTX_VERSION: str = "0.1.0"

def banner(title: str) -> str {
    inner: str = " " + title + " "
    return inner.center(30, "=")
}

def bracket(s: str) -> str {
    return "[" + stringx.shout(s) + "]"
}
