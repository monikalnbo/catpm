+# like ">=x" or ">=" never matches instead of silently meaning ">=0.0.0"
+# (v0.5.2: previously seg() returned 0 for junk, making every version match).
+def valid_bound(b: str) -> bool {
+    if b == "" {
+        return False
+    }
+    n: int = vlen(b)
+    if n < 1 or n > 3 {
+        return False
+    }
+    # vlen stops at the first non-digit segment; n == number of '.'-split
+    # segments means every segment scanned was all digits
+    ps: list[str] = b.split(".")
+    return n == len(ps)
