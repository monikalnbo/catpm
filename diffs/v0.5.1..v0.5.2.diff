+# CatBase v0.1.8 has no is_dir(); opening a directory with file() panics the
+# runtime (SIGABRT). Guard user-controlled paths with stat before opening.
+def path_is_dir(p: str) -> bool {
+    if not file_exists(p) {
+        return False
+    }
+    out: str = exec("stat -c %F '" + p + "' 2>/dev/null")
+    return out.strip().startswith("directory")
