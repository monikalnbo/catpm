+# ============ base conversion (2..36) ============
+
+def to_base(n: int, base: int) -> str {
+    # non-negative and negative n; digits 0-9 then a-z
+    if base < 2 or base > 36 {
+        return ""
+    }
+    if n == 0 {
+        return "0"
+    }
+    neg: bool = False
+    m: int = n
+    if m < 0 {
+        neg = True
+        m = 0 - m
+    }
+    digits: str = "0123456789abcdefghijklmnopqrstuvwxyz"
+    rev: list[str] = []
+    while m > 0 {
+        d: int = m % base
+        rev.append(digits[d:d+1])
+        m = m / base
+    }
+    out: str = ""
+    if neg {
+        out = "-"
+    }
+    i: int = len(rev) - 1
+    while i >= 0 {
+        out = out + rev[i]
+        i = i - 1
+    }
+    return out
+}
+
+def from_base(s: str, base: int) -> int {
+    # accepts upper or lower case digits; invalid input returns 0
+    if base < 2 or base > 36 {
+        return 0
+    }
+    if len(s) == 0 {
+        return 0
+    }
+    start: int = 0
+    neg: bool = False
+    first: str = s[0:1]
+    if first == "-" {
+        neg = True
+        start = 1
+    }
+    v: int = 0
+    i: int = start
+    while i < len(s) {
+        c: str = s[i:i+1]
+        d: int = digit_val(c)
+        if d < 0 or d >= base {
+            return 0
+        }
+        v = v * base + d
+        i = i + 1
+    }
+    if neg {
+        return 0 - v
+    }
+    return v
+}
+
+def digit_val(c: str) -> int {
+    # single char to its value: 0-9 -> 0..9, a-z -> 10..35, else -1
+    o: int = ord(c)
+    if o >= 48 and o <= 57 {
+        return o - 48
+    }
+    if o >= 97 and o <= 122 {
+        return o - 87
+    }
+    if o >= 65 and o <= 90 {
+        return o - 55
+    }
+    return -1
+}
