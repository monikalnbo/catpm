+# ============ powers & roots ============
+
+def power(base: int, e: int) -> int {
+    # fast exponentiation by squaring; e < 0 returns 0
+    if e < 0 {
+        return 0
+    }
+    result: int = 1
+    b: int = base
+    k: int = e
+    while k > 0 {
+        if k % 2 == 1 {
+            result = result * b
+        }
+        b = b * b
+        k = k / 2
+    }
+    return result
+}
+
+def mod_pow(base: int, e: int, m: int) -> int {
+    # modular exponentiation; intermediates stay within i64 when
+    # m <= 3037000499 (sqrt of 2^63), since x*x < m*m < 2^63
+    if m == 1 {
+        return 0
+    }
+    result: int = 1
+    b: int = base % m
+    k: int = e
+    while k > 0 {
+        if k % 2 == 1 {
+            result = result * b % m
+        }
+        b = b * b % m
+        k = k / 2
+    }
+    return result
+}
+
+def isqrt(n: int) -> int {
+    # largest r with r*r <= n, via integer Newton; n < 0 returns -1
+    if n < 0 {
+        return -1
+    }
+    if n < 2 {
+        return n
+    }
+    x: int = n
+    y: int = (x + n / x) / 2
+    while y < x {
+        x = y
+        y = (x + n / x) / 2
+    }
+    return x
+}
+
+def sqrt_float(x: float) -> float {
+    # Newton iteration; CatBase has no sqrt builtin; x < 0 returns 0.0
+    if x <= 0.0 {
+        return 0.0
+    }
+    z: float = x
+    half: float = 0.5
+    i: int = 0
+    done: bool = False
+    while not done {
+        nz: float = (z + x / z) * half
+        d: float = nz - z
+        if d < 0.0 {
+            d = 0.0 - d
+        }
+        if d < 1e-15 {
+            z = nz
+            done = True
+        } else {
+            z = nz
+            i = i + 1
+            if i > 80 {
+                done = True
+            }
+        }
+    }
+    return z
+}
+
+def cbrt_float(x: float) -> float {
+    # Newton on z^3 - x; handles negatives (odd root)
+    if x == 0.0 {
+        return 0.0
+    }
+    neg: bool = False
+    a: float = x
+    if a < 0.0 {
+        neg = True
+        a = 0.0 - a
+    }
+    z: float = a
+    third: float = 1.0 / 3.0
+    i: int = 0
+    done: bool = False
+    while not done {
+        z2: float = z * z
+        nz: float = (2.0 * z + a / z2) * third
+        d: float = nz - z
+        if d < 0.0 {
+            d = 0.0 - d
+        }
+        if d < 1e-15 {
+            z = nz
+            done = True
+        } else {
+            z = nz
+            i = i + 1
+            if i > 100 {
+                done = True
+            }
+        }
+    }
+    if neg {
+        return 0.0 - z
+    }
+    return z
+}
+
+def hypot(a: float, b: float) -> float {
+    return sqrt_float(a * a + b * b)
+}
