+def ln(x: float) -> float {
+    # ln(x) = m*ln2 + ln(f) with x = 2^m * f, f in [1,2);
+    # ln(f) via the atanh series 2*(y + y^3/3 + y^5/5 + ...),
+    # y = (f-1)/(f+1), |y| <= 1/3 so 20 terms give ~1e-12
+    if x <= 0.0 {
+        return 0.0 - 1e308
+    }
+    ln2: float = 0.6931471805599453
+    m: int = 0
+    f: float = x
+    while f >= 2.0 {
+        f = f / 2.0
+        m = m + 1
+    }
+    while f < 1.0 {
+        f = f * 2.0
+        m = m - 1
+    }
+    y: float = (f - 1.0) / (f + 1.0)
+    y2: float = y * y
+    term: float = y
+    sum: float = y
+    n: int = 1
+    while n <= 20 {
+        term = term * y2
+        sum = sum + term / float(2 * n + 1)
+        n = n + 1
+    }
+    two: float = 2.0
+    return two * sum + float(m) * ln2
+}
+
+def log10(x: float) -> float {
+    ln10: float = 2.302585092994046
+    return ln(x) / ln10
+}
+
+def log2(x: float) -> float {
+    return ln(x) / 0.6931471805599453
+}
+
+def pow_float(b: float, e: float) -> float {
+    # b > 0: exp(e*ln(b)); b == 0 and e > 0 gives 0.0;
+    # b < 0 only for integer e; other cases return 0.0
+    if b == 0.0 {
+        if e > 0.0 {
+            return 0.0
+        }
+        return 1.0
+    }
+    if b < 0.0 {
+        isint: bool = e == float(int(e))
+        if isint {
+            n: int = int(e)
+            if n < 0 {
+                nb: float = 0.0 - b
+                inv: float = pow_float(nb, float(0 - n))
+                return 1.0 / inv
+            }
+            r: float = 1.0
+            i: int = 0
+            while i < n {
+                r = r * b
+                i = i + 1
+            }
+            return r
+        }
+        return 0.0
+    }
+    return exp(e * ln(b))
+}
+
+def deg2rad(d: float) -> float {
+    return d * PI / 180.0
+}
+
+def rad2deg(r: float) -> float {
+    return r * 180.0 / PI
+}
+
+def loud_double(n: int) -> str {
+    # kept from mathx 0.4.0: stringx round trip through the deps tree
+    return stringx.shout(str(n * 2))
+}
