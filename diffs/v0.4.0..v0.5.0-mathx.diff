+# ============ combinatorics ============
+
+def factorial(n: int) -> int {
+    # n < 0 returns -1
+    if n < 0 {
+        return -1
+    }
+    r: int = 1
+    i: int = 2
+    while i <= n {
+        r = r * i
+        i = i + 1
+    }
+    return r
+}
+
+def perm(n: int, k: int) -> int {
+    # falling factorial n*(n-1)*...*(n-k+1); out-of-range returns 0
+    if k < 0 or n < 0 or k > n {
+        return 0
+    }
+    r: int = 1
+    i: int = 0
+    while i < k {
+        r = r * (n - i)
+        i = i + 1
+    }
+    return r
+}
+
+def comb(n: int, k: int) -> int {
+    # binomial coefficient, exact multiplicative formula
+    if k < 0 or n < 0 or k > n {
+        return 0
+    }
+    if k > n - k {
+        k = n - k
+    }
+    r: int = 1
+    i: int = 0
+    while i < k {
+        r = r * (n - i) / (i + 1)
+        i = i + 1
+    }
+    return r
+}
+
+def fib(n: int) -> int {
+    # iterative; n <= 0 returns 0 (same semantics as mathx 0.4.0)
+    if n <= 0 {
+        return 0
+    }
+    a: int = 0
+    b: int = 1
+    i: int = 1
+    while i < n {
+        t: int = a + b
+        a = b
+        b = t
+        i = i + 1
+    }
+    return b
+}
