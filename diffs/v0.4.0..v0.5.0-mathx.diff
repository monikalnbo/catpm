+def exp(x: float) -> float {
+    # e^x = 2^k * e^r with |r| <= ln2/2, then Taylor on r
+    if x == 0.0 {
+        return 1.0
+    }
+    ln2: float = 0.6931471805599453
+    half_ln2: float = ln2 / 2.0
+    k: int = 0
+    r: float = x
+    while r > half_ln2 {
+        r = r - ln2
+        k = k + 1
+    }
+    while r < 0.0 - half_ln2 {
+        r = r + ln2
+        k = k - 1
+    }
+    term: float = 1.0
+    sum: float = 1.0
+    n: int = 1
+    while n <= 18 {
+        term = term * r / float(n)
+        sum = sum + term
+        n = n + 1
+    }
+    if k > 0 {
+        i: int = 0
+        while i < k {
+            sum = sum * 2.0
+            i = i + 1
+        }
+    } else {
+        j: int = k
+        while j < 0 {
+            sum = sum / 2.0
+            j = j + 1
+        }
+    }
+    return sum
+}
