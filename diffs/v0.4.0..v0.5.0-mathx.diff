+def sin(x: float) -> float {
+    pi2: float = PI * 2.0
+    t: float = x
+    while t > PI {
+        t = t - pi2
+    }
+    while t < 0.0 - PI {
+        t = t + pi2
+    }
+    if t > PI / 2.0 {
+        t = PI - t
+    }
+    if t < 0.0 - PI / 2.0 {
+        t = 0.0 - PI - t
+    }
+    term: float = t
+    sum: float = t
+    x2: float = t * t
+    n: int = 1
+    while n <= 13 {
+        denom: int = (2 * n) * (2 * n + 1)
+        term = term * x2 / float(denom)
+        if n % 2 == 1 {
+            sum = sum - term
+        } else {
+            sum = sum + term
+        }
+        n = n + 1
+    }
+    return sum
+}
+
+def cos(x: float) -> float {
+    half: float = PI / 2.0
+    return sin(x + half)
+}
+
+def tan(x: float) -> float {
+    c: float = cos(x)
+    if c == 0.0 {
+        return 0.0
+    }
+    return sin(x) / c
+}
+
+def atan(x: float) -> float {
+    # reduce to (0, 1/sqrt3] then Taylor; recursion depth at most 2
+    if x < 0.0 {
+        return 0.0 - atan(0.0 - x)
+    }
+    if x > 1.0 {
+        inv: float = 1.0 / x
+        return PI / 2.0 - atan(inv)
+    }
+    sq3: float = sqrt_float(3.0)
+    bound: float = 1.0 / sq3
+    if x > bound {
+        # x = tan(pi/6 + a) -> a = atan((x*sqrt3 - 1)/(x + sqrt3))
+        u: float = (x * sq3 - 1.0) / (x + sq3)
+        return PI / 6.0 + atan(u)
+    }
+    x2: float = x * x
+    term: float = x
+    sum: float = x
+    n: int = 1
+    while n <= 15 {
+        term = term * x2
+        d: float = float(2 * n + 1)
+        if n % 2 == 1 {
+            sum = sum - term / d
+        } else {
+            sum = sum + term / d
+        }
+        n = n + 1
+    }
+    return sum
+}
