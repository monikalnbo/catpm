+    hexd: str = "0123456789abcdef"
+    out: str = ""
+    i: int = 0
+    hi: int = 0
+    lo: int = 0
+    while i < n {
+        b: int = _unbiased(256)
+        hi = b / 16
+        lo = b % 16
+        out = out + hexd[hi] + hexd[lo]
+        i = i + 1
+    }
+    return out
+}
