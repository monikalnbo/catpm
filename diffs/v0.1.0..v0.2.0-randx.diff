+# standard normal via Box-Muller (uses mathx.log / mathx.cos / mathx.PI)
+def normal() -> float {
+    u1: float = random()
+    u2: float = random()
+    if u1 < 1e-15 {
+        u1 = 1e-15
+    }
+    r: float = mathx.sqrt_float(0 - 2.0 * mathx.ln(u1))
+    return r * mathx.cos(2.0 * mathx.PI * u2)
+}
+
+# standard normal, mean mu / stddev sigma
+def normal_mu_sigma(mu: float, sigma: float) -> float {
+    return mu + sigma * normal()
+}
+
+# Poisson(lam) via Knuth's method (uses mathx.exp); lam > 0
+def poisson(lam: float) -> int {
+    if lam <= 0.0 {
+        return 0
+    }
+    L: float = mathx.exp(0 - lam)
+    k: int = 0
+    p: float = 1.0
+    while True {
+        p = p * random()
+        if p <= L {
+            break
+        }
+        k = k + 1
+    }
+    return k
+}
