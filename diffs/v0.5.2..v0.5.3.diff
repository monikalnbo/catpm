+# ---------- prebuilt binaries (v0.5.3) ----------
+# A .cpkg may carry a prebuilt executable at bin/<name>. On install the file
+# lands in deps/<name>/bin/<name>, gets its exec bit restored (tar drops it
+# when the packer's umask masks it), and is smoke-checked with --version or
+# --help. Packages without bin/ install exactly as before (pure source).
+#
+# Why not compile-on-install: CatBase has no stable ABI or linker story; the
+# only consumer model is "single-entry source, imports inlined at compile
+# time". A prebuilt binary can only serve standalone tools (like catpm
+# itself), not importable libraries — those remain source-vendored by design.
+
+def host_platform() -> str {
+    # "linux-x86_64" / "linux-aarch64" / "darwin-arm64" ... via uname
+    sys: str = exec("uname -s").strip().lower()
+    mach: str = exec("uname -m").strip().lower()
+    if sys == "linux" {
+        return "linux-" + mach
+    }
+    return sys + "-" + mach
+}
+
+def is_elf(path: str) -> bool {
+    # CatBase has no \xNN escapes (issue #5) and an int index into a str
+    # read in binary mode returns "" — only slices are safe. Check the
+    # 0x7f magic byte through ord(all[0:1]).
+    f: File = file(path, "rb")
+    all: str = f.read()
+    f.close()
+    if len(all) < 4 {
+        return False
+    }
+    if ord(all[0:1]) != 127 {
+        return False
+    }
+    return all[1:4] == "ELF"
+}
+
+def elf_arch_of(path: str) -> str {
+    # e_machine is a little-endian u16 at offset 18
+    f: File = file(path, "rb")
+    body: str = f.read()
+    f.close()
+    if len(body) < 20 {
+        return "?"
+    }
+    lo: int = ord(body[18:19])
+    hi: int = ord(body[19:20])
+    m: int = lo + hi * 256
+    if m == 62 {
+        return "x86_64"
+    }
+    if m == 183 {
+        return "aarch64"
+    }
+    if m == 40 {
+        return "arm"
+    }
+    if m == 3 {
+        return "x86"
+    }
+    return "other"
+}
+
+# check deps/<name>/bin/<name>: executable, ELF-or-shebang, arch matches host
+def prebuilt_check(binp: str) -> str {
+    # result: "" = ok; otherwise a reason string (printed by caller)
+    out: str = exec("stat -c %A '" + binp + "' 2>/dev/null").strip()
+    if out == "" {
+        return "stat failed"
+    }
+    if out.find("x") < 0 {
+        return "no exec bit (mode " + out + ")"
+    }
+    if is_elf(binp) {
+        arch: str = elf_arch_of(binp)
+        host: str = host_platform()
+        if host.find(arch) < 0 {
+            return "ELF " + arch + " but host is " + host
+        }
+    } else {
+        # not ELF: only a #! script is an acceptable prebuilt. Anything else
+        # (e.g. a text file that merely carries the exec bit) would be run by
+        # the shell's ENOEXEC fallback, "execute" garbage, and still look
+        # alive because exec() always sees rc 0 — reject deterministically.
+        f: File = file(binp, "rb")
+        head: str = f.read()
+        f.close()
+        if len(head) < 2 or head[0:2] != "#!" {
+            return "neither ELF nor #! script (first bytes are not a known executable format)"
+        }
+    }
+    run: str = exec("'" + binp + "' --version 2>&1 || '" + binp + "' --help 2>&1 || true")
+    if run.strip() == "" {
+        return "produced no output with --version/--help (not runnable?)"
+    }
+    return ""
+}
