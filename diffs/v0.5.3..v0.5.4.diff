+# scan one source index for the newest catpm version; updates 'best' in place
+# is impossible (no refs), so returns the newer of best-so-far and scan result
+def newest_self_in(idx: dict[str, any], best: str) -> str {
+    vs: dict[str, any] = index_versions(idx, "catpm")
+    vk: list[str] = vs.keys()
+    out: str = best
+    j: int = 0
+    while j < len(vk) {
+        cand: str = vk[j]
+        if ver.valid_version(cand) {
+            if out == "" {
+                out = cand
+            } else if ver.vcmp(cand, out) > 0 {
+                out = cand
+            }
+        }
+        j = j + 1
+    }
+    return out
+}
+
+def print_self_notice(newest: str) {
+    if newest != "" and ver.vcmp(newest, CATPM_VERSION) > 0 {
+        print("catpm: notice: new version available: current " + CATPM_VERSION + ", available " + newest + " — run 'catpm self-update'")
+    }
+}
+
+# pip-style new-version notice: fetch the source index LIVE (never the
+# cache — a just-published release must show up immediately), find the
+# newest catpm, and if it is newer than the running binary print the
+# notice. Best-effort: any failure (offline, no catpm package published)
+# stays silent so this never breaks the host command.
+def maybe_print_newer_self() {
+    st: dict[str, any] = load_sources()
+    rav: any = st.get("roots", None)
+    roots: list[str] = rav
+    i: int = 0
+    newest: str = ""
+    while i < len(roots) {
+        r: str = roots[i]
+        body: str = ""
+        if kind_of(r) == "url" {
+            body = http_fetch_soft(r + "/index.json")
+        } else {
+            p: str = r + "/index.json"
+            if file_exists(p) and not path_is_dir(p) {
+                f: File = file(p, "r")
+                body = f.read()
+                f.close()
+            }
+        }
+        if body != "" and body.strip().startswith("{") {
+            idx: dict[str, any] = json_loads(body.strip())
+            newest = newest_self_in(idx, newest)
+        }
+        i = i + 1
+    }
+    print_self_notice(newest)
+}
