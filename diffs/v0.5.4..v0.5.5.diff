+# 'catpm fix': detect and repair everything an interrupted run can leave
+# behind, then report. Exit 0 when the tree is consistent afterwards.
+#   1. *.catpm-tmp next to state files (crash mid atomic_write)
+#   2. deps/.stage-* dirs (crash mid unpack of a package)
+#   3. cached .cpkg files whose sha256 disagrees with the current index
+#      (crash mid download) — deleted so the next install re-downloads
+#   4. interrupted self-update residues (catpm.new / self-stage)
+#   5. deps/<name> present but lock missing the entry: left to the user
+#      (a lock-exact 'install' or 'add' resolves it) — reported, not guessed
+def cmd_fix() {
+    print("catpm: fix — scanning for interrupted-run residues")
+    fixed: int = 0
+    # 1. orphaned atomic-write temporaries
+    tmps: list[str] = [MANIFEST + ".catpm-tmp", LOCKFILE + ".catpm-tmp",
+                       idx_cachedir() + "/meta.json.catpm-tmp"]
+    if isdir(idx_cachedir()) {
+        ic: list[str] = listdir(idx_cachedir())
+        j: int = 0
+        while j < len(ic) {
+            if ic[j].endswith(".catpm-tmp") {
+                tmps.append(idx_cachedir() + "/" + ic[j])
+            }
+            j = j + 1
+        }
+    }
+    i: int = 0
+    while i < len(tmps) {
+        if file_exists(tmps[i]) {
+            sh_die("rm -f '" + tmps[i] + "'", "sweep " + tmps[i])
+            print("  swept orphaned temp: " + tmps[i])
+            fixed = fixed + 1
+        }
+        i = i + 1
+    }
+    # 2. staged unpack dirs
+    if isdir(DEPSDIR) {
+        dents: list[str] = listdir(DEPSDIR)
+        i = 0
+        while i < len(dents) {
+            if dents[i].startswith(".stage-") and isdir(DEPSDIR + "/" + dents[i]) {
+                sh_die("rm -rf '" + DEPSDIR + "/" + dents[i] + "'", "sweep " + dents[i])
+                print("  swept interrupted unpack: " + DEPSDIR + "/" + dents[i])
+                fixed = fixed + 1
+            }
+            i = i + 1
+        }
+    }
+    # 4. self-update residues
+    fixed = fixed + sweep_self_residues(self_bindir())
+    # 3. corrupt cache entries (needs the index for sha256s; offline or no
+    #    sources -> skipped honestly, the next install re-checks anyway)
+    st: dict[str, any] = load_sources()
+    fetch_all_cached(st)
+    oa: any = st.get("ok", None)
+    ok: list[str] = oa
+    ia: any = st.get("idxs", None)
+    idxs: dict[str, any] = ia
+    if isdir(CACHEDIR) {
+        names: list[str] = listdir(CACHEDIR)
+        i = 0
+        while i < len(names) {
+            cname: str = names[i]
+            if isdir(CACHEDIR + "/" + cname) {
+                fs: list[str] = listdir(CACHEDIR + "/" + cname)
+                j: int = 0
+                while j < len(fs) {
+                    fname: str = fs[j]
+                    if fname.endswith(".cpkg") and fname.startswith(cname + "-") {
+                        # name-<version>.cpkg -> version in the middle
+                        stem: str = fname[0:len(fname) - len(".cpkg")]
+                        vpart: str = stem[len(cname) + 1:len(stem)]
+                        if vpart != "" {
+                            ent: dict[str, any] = {}
+                            m: int = 0
+                            while m < len(ok) {
+                                iv: any = idxs.get(ok[m], None)
+                                if iv is not None {
+                                    idxd: dict[str, any] = iv
+                                    e2: dict[str, any] = index_entry(idxd, cname, vpart)
+                                    if len(e2.keys()) > 0 {
+                                        ent = e2
+                                        break
+                                    }
+                                }
+                                m = m + 1
+                            }
+                            want: str = util.get_str(ent, "sha256", "")
+                            if want != "" {
+                                p: str = CACHEDIR + "/" + cname + "/" + fname
+                                got: str = sha256_of(p)
+                                if got != want {
+                                    sh_die("rm -f '" + p + "'", "purge corrupt cache " + p)
+                                    print("  purged corrupt cached package (sha256 mismatch): " + p)
+                                    fixed = fixed + 1
+                                }
+                            }
+                        }
+                    }
+                    j = j + 1
+                }
+            }
+            i = i + 1
+        }
+    }
+    # 5. report deps/ entries the lock does not know about
+    if isdir(DEPSDIR) {
+        lock: dict[str, str] = read_lock()
+        dents: list[str] = listdir(DEPSDIR)
+        i = 0
+        while i < len(dents) {
+            n: str = dents[i]
+            if isdir(DEPSDIR + "/" + n) and not n.startswith(".") {
+                if not lock.contains(n) {
+                    print("  note: " + DEPSDIR + "/" + n + " has no lock entry (install/add will reinstall or prune it)")
+                }
+            }
+            i = i + 1
+        }
+    }
+    print("catpm: fix complete (" + str(fixed) + " item(s) repaired)")
