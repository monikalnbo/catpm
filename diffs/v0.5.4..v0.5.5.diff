+# ---------- crash-safe file writes (v0.5.5) ----------
+# File.write() is an unbuffered writeAll: a kill -9 / Ctrl+C mid-write leaves
+# a truncated file behind, and json_loads() silently parses garbage into {}
+# (probed: truncated/garbage/empty all yield keys()==0, no error). So every
+# state file (manifest, lock, index cache, meta.json) is written through this
+# helper: full body to <path>.catpm-tmp first, then mv -f (same-directory
+# rename(2), atomic in the kernel) over the real name. A crash at ANY point
+# leaves either the old intact file or the untouched new name — never a
+# half-written one. Orphaned .catpm-tmp files are swept by 'catpm fix'.
+def atomic_write(path: str, body: str) {
+    # skip the tmp+mv round when the target already holds exactly these bytes
+    # (idempotent re-runs: re-add same pkg, repeated index refreshes). Saves a
+    # fork+rename per unchanged file; crash-safety of the write itself is
+    # unchanged because we don't write at all.
+    if file_exists(path) {
+        rf: File = file(path, "r")
+        cur: str = rf.read()
+        rf.close()
+        if cur == body {
+            return
+        }
+    }
+    tmp: str = path + ".catpm-tmp"
+    f: File = file(tmp, "w")
+    f.write(body)
+    f.close()
+    sh_die("mv -f '" + tmp + "' '" + path + "'", "atomically replace " + path)
