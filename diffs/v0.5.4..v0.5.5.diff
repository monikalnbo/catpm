+# v0.5.5: remove leftovers of an interrupted self-update: a staged candidate
+# binary (<bindir>/catpm.new) and/or the self-stage unpack dir. These are
+# never valid state — the next self-update rebuilds both from scratch.
+# Returns how many items were swept (0 = clean).
+def sweep_self_residues(bd: str) -> int {
+    n: int = 0
+    cand: str = bd + "/catpm.new"
+    if file_exists(cand) {
+        sh_die("rm -f '" + cand + "'", "sweep stale candidate " + cand)
+        print("catpm: swept interrupted self-update residue: " + cand)
+        n = n + 1
+    }
+    stage: str = CACHEDIR + "/self-stage"
+    if isdir(stage) {
+        sh_die("rm -rf '" + stage + "'", "sweep stale self-stage")
+        print("catpm: swept interrupted self-update residue: " + stage)
+        n = n + 1
+    }
+    return n
+}
