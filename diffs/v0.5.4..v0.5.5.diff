+# the first source that can serve it, ignoring any cache. Returns the index
+# sha256 of the fetched copy ("" = index lists no sha, or every source failed
+# — caller distinguishes via file_exists(cpkg)).
+def refetch_cpkg(st: dict[str, any], name: str, version: str, cpkg: str) -> str {
+    ia: any = st.get("idxs", None)
+    idxs: dict[str, any] = ia
+    vers: dict[str, any] = merged_versions(st, name)
+    rv: any = vers.get(version, None)
+    if rv is None {
+        return ""
+    }
+    roots_any: list[str] = rv
+    k: int = 0
+    while k < len(roots_any) {
