import ./ver.catc as ver

def expect(label: str, got: bool, want: bool) -> int {
    if got != want {
        print("FAIL ", label, " got=", got, " want=", want)
        return 1
    }
    return 0
}

def main() {
    bad: int = 0
    bad = bad + expect("vcmp 1.10.0>1.9.0", ver.vcmp("1.10.0", "1.9.0") == 1, True)
    bad = bad + expect("vcmp 0.1.0<0.2.0", ver.vcmp("0.1.0", "0.2.0") == -1, True)
    bad = bad + expect("vcmp eq", ver.vcmp("1.2.3", "1.2.3") == 0, True)
    bad = bad + expect("vcmp 1.0 vs 1.0.0", ver.vcmp("1.0", "1.0.0") == 0, True)
    bad = bad + expect("bump maj", ver.bump("1.2.3", 0) == "2.0.0", True)
    bad = bad + expect("bump min", ver.bump("1.2.3", 1) == "1.3.0", True)
    bad = bad + expect("bump 0.2.3 min", ver.bump("0.2.3", 1) == "0.3.0", True)
    bad = bad + expect("exact ok", ver.satisfies("1.2.3", "1.2.3"), True)
    bad = bad + expect("exact no", ver.satisfies("1.2.4", "1.2.3"), False)
    bad = bad + expect("caret in", ver.satisfies("1.5.0", "^1.2.0"), True)
    bad = bad + expect("caret below", ver.satisfies("1.1.9", "^1.2.0"), False)
    bad = bad + expect("caret above", ver.satisfies("2.0.0", "^1.2.0"), False)
    bad = bad + expect("caret eq", ver.satisfies("1.2.0", "^1.2.0"), True)
    bad = bad + expect("caret 0 locks minor", ver.satisfies("0.2.9", "^0.2.3"), True)
    bad = bad + expect("caret 0 excl minor", ver.satisfies("0.3.0", "^0.2.3"), False)
    bad = bad + expect("tilde in", ver.satisfies("1.2.9", "~1.2.3"), True)
    bad = bad + expect("tilde excl", ver.satisfies("1.3.0", "~1.2.3"), False)
    bad = bad + expect("ge", ver.satisfies("1.2.0", ">=1.0.0"), True)
    bad = bad + expect("gt", ver.satisfies("1.0.1", ">1.0.0"), True)
    bad = bad + expect("gt eq no", ver.satisfies("1.0.0", ">1.0.0"), False)
    bad = bad + expect("lt", ver.satisfies("1.9.9", "<2.0.0"), True)
    bad = bad + expect("le", ver.satisfies("2.0.0", "<=2.0.0"), True)
    bad = bad + expect("latest", ver.satisfies("0.0.1", "latest"), True)
    bad = bad + expect("star", ver.satisfies("0.0.1", "*"), True)
    bad = bad + expect("and both hold", ver.satisfies("0.2.5", ">=0.2.0,<0.3.0"), True)
    bad = bad + expect("and upper fails", ver.satisfies("0.3.0", ">=0.2.0,<0.3.0"), False)
    bad = bad + expect("and lower fails", ver.satisfies("0.1.9", ">=0.2.0,<0.3.0"), False)
    bad = bad + expect("and with caret", ver.satisfies("0.2.9", "^0.2.0,<0.2.5"), False)
    bad = bad + expect("and eq pin", ver.satisfies("1.2.3", "1.2.3,>=1.0.0"), True)
    bad = bad + expect("and spaces ok", ver.satisfies("0.2.0", ">=0.2.0 , <0.3.0"), True)
    bad = bad + expect("and latest member", ver.satisfies("1.0.0", "latest,>=1.0.0"), True)
    cands: list[str] = ["0.1.0", "0.2.0", "0.10.0", "0.9.0", "notaver"]
    bad = bad + expect("best latest", ver.best_match(cands, "latest") == "0.10.0", True)
    bad = bad + expect("best caret", ver.best_match(cands, "^0.2.0") == "0.2.0", True)
    bad = bad + expect("best ge", ver.best_match(cands, ">=0.9.0") == "0.10.0", True)
    bad = bad + expect("best none", ver.best_match(cands, ">=1.0.0") == "", True)
    bad = bad + expect("best and-list", ver.best_match(cands, ">=0.2.0,<0.10.0") == "0.9.0", True)
    bad = bad + expect("best star", ver.best_match(cands, "*") == "0.10.0", True)
    sp: list[str] = ver.split_pkg("mathx@^1.2.0")
    bad = bad + expect("split name", sp[0] == "mathx", True)
    bad = bad + expect("split spec", sp[1] == "^1.2.0", True)
    sp2: list[str] = ver.split_pkg("fmtx")
    bad = bad + expect("split default", sp2[1] == "latest", True)
    sp3: list[str] = ver.split_pkg("fmtx@")
    bad = bad + expect("split empty-spec flagged", sp3[1] == "!invalid", True)
    bad = bad + expect("satisfies empty spec no", ver.satisfies("1.0.0", ""), False)
    bad = bad + expect("trailing comma member fails", ver.satisfies("1.0.0", ">=0.2.0,"), False)
    bad = bad + expect("plain spaces spec no", ver.satisfies("1.0.0", "  "), False)
    # v0.5.2: malformed bounds must never match (previously junk like ">=x"
    # silently compared as >=0.0.0 because seg() returns 0 for non-digits)
    bad = bad + expect("bound '' invalid", ver.valid_bound(""), False)
    bad = bad + expect("bound '0' valid", ver.valid_bound("0"), True)
    bad = bad + expect("bound '1.2' valid", ver.valid_bound("1.2"), True)
    bad = bad + expect("bound '1.2.3' valid", ver.valid_bound("1.2.3"), True)
    bad = bad + expect("bound '1.2.3.4' invalid", ver.valid_bound("1.2.3.4"), False)
    bad = bad + expect("bound 'x' invalid", ver.valid_bound("x"), False)
    bad = bad + expect("junk '>=' no match", ver.satisfies("0.1.0", ">="), False)
    bad = bad + expect("junk '>=x' no match", ver.satisfies("0.1.0", ">=x"), False)
    bad = bad + expect("junk '<=y' no match", ver.satisfies("0.1.0", "<=y"), False)
    bad = bad + expect("junk '>z' no match", ver.satisfies("0.1.0", ">z"), False)
    bad = bad + expect("junk '<q' no match", ver.satisfies("0.1.0", "<q"), False)
    bad = bad + expect("junk '^w' no match", ver.satisfies("0.1.0", "^w"), False)
    bad = bad + expect("junk '~e' no match", ver.satisfies("0.1.0", "~e"), False)
    bad = bad + expect("junk exact '0.5.x' no match", ver.satisfies("0.5.1", "0.5.x"), False)
    bad = bad + expect("short '>=0' still matches", ver.satisfies("0.1.0", ">=0"), True)
    bad = bad + expect("short '>=1' still ok", ver.satisfies("0.1.0", ">=1"), False)
    bad = bad + expect("junk best_match empty", ver.best_match(cands, ">=x") == "", True)
    if bad == 0 {
        print("ALL VER TESTS PASSED")
    } else {
        print("FAILURES: ", bad)
        exit(1)
    }
}
