# ver.catc - version parsing / comparison / specifier satisfaction (protocol layer 2)
# Supported specifiers (subset actually implemented & tested):
#   1.2.3        exact
#   ^1.2.3       same major: >=1.2.3 <2.0.0   (^0.2.3 -> >=0.2.3 <0.3.0)
#   ~1.2.3       same minor: >=1.2.3 <1.3.0
#   >=1.2.0      lower bound (also > with has_equal handling below)
#   <=2.0.0      upper bound
#   >1.0.0  <2.0.0   strict bounds
#   latest       any version (registry picks highest)
# NOT supported (documented as unsupported): * , x-ranges, ||, , (AND lists), ~=

def vlen(v: str) -> int {
    # number of dot-separated numeric segments (trailing junk ignored)
    ps: list[str] = v.split(".")
    n: int = 0
    i: int = 0
    while i < len(ps) {
        p: str = ps[i]
        ok: bool = len(p) > 0
        if ok {
            j: int = 0
            while j < len(p) {
                c: str = p[j:j+1]
                if not is_digit(c) {
                    ok = False
                }
                j = j + 1
            }
        }
        if not ok {
            return n
        }
        n = n + 1
        i = i + 1
    }
    return n
}

def seg(v: str, i: int) -> int {
    ps: list[str] = v.split(".")
    if i >= len(ps) {
        return 0
    }
    p: str = ps[i]
    if len(p) == 0 {
        return 0
    }
    j: int = 0
    while j < len(p) {
        if not is_digit(p[j:j+1]) {
            return 0
        }
        j = j + 1
    }
    return int(p)
}

# -1 a<b  0 a==b  1 a>b   (numeric per segment, missing = 0)
def vcmp(a: str, b: str) -> int {
    n: int = vlen(a)
    if vlen(b) > n {
        n = vlen(b)
    }
    i: int = 0
    while i < n {
        x: int = seg(a, i)
        y: int = seg(b, i)
        if x < y {
            return -1
        }
        if x > y {
            return 1
        }
        i = i + 1
    }
    return 0
}

def is_digit(c: str) -> bool {
    if c == "0" { return True }
    if c == "1" { return True }
    if c == "2" { return True }
    if c == "3" { return True }
    if c == "4" { return True }
    if c == "5" { return True }
    if c == "6" { return True }
    if c == "7" { return True }
    if c == "8" { return True }
    if c == "9" { return True }
    return False
}

def valid_version(v: str) -> bool {
    if vlen(v) != 3 {
        return False
    }
    return True
}

# upper bound for caret/tilde: bump segment i by one, zero the rest.
# bump("1.2.3",0)="2.0.0"  bump("1.2.3",1)="1.3.0"  bump("0.2.3",1)="0.3.0"
def bump(v: str, i: int) -> str {
    a: int = seg(v, 0)
    b: int = seg(v, 1)
    if i == 0 {
        a = a + 1
        b = 0
    }
    if i == 1 {
        b = b + 1
    }
    return str(a) + "." + str(b) + ".0"
}

# parse "name@spec" or bare "name" -> spec defaults to "latest"
def split_pkg(s: str) -> list[str] {
    out: list[str] = []
    at: int = s.find("@")
    if at < 0 {
        out.append(s)
        out.append("latest")
        return out
    }
    out.append(s[0:at])
    out.append(s[at+1:len(s)])
    return out
}

# does version v satisfy specifier spec?
def satisfies(v: str, spec: str) -> bool {
    if spec == "latest" or spec == "*" or spec == "" {
        return True
    }
    if spec.startswith(">=") {
        b: str = spec[2:len(spec)]
        return vcmp(v, b) >= 0
    }
    if spec.startswith("<=") {
        b: str = spec[2:len(spec)]
        return vcmp(v, b) <= 0
    }
    if spec.startswith(">") {
        b: str = spec[1:len(spec)]
        return vcmp(v, b) > 0
    }
    if spec.startswith("<") {
        b: str = spec[1:len(spec)]
        return vcmp(v, b) < 0
    }
    if spec.startswith("^") {
        b: str = spec[1:len(spec)]
        if vcmp(v, b) < 0 {
            return False
        }
        # major 0: caret locks minor instead
        if seg(b, 0) == 0 {
            return vcmp(v, bump(b, 1)) < 0
        }
        return vcmp(v, bump(b, 0)) < 0
    }
    if spec.startswith("~") {
        b: str = spec[1:len(spec)]
        if vcmp(v, b) < 0 {
            return False
        }
        return vcmp(v, bump(b, 1)) < 0
    }
    # exact
    return vcmp(v, spec) == 0
}

# pick highest version from candidates satisfying spec; "" if none
def best_match(cands: list[str], spec: str) -> str {
    best: str = ""
    i: int = 0
    while i < len(cands) {
        c: str = cands[i]
        if valid_version(c) and satisfies(c, spec) {
            if best == "" {
                best = c
            } else if vcmp(c, best) > 0 {
                best = c
            }
        }
        i = i + 1
    }
    return best
}
