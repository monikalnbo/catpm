# ============================================================
# catpm v0.4.0 — dependency package manager for CatBase v0.1.8
# written in CatBase, compiled by catcc to a native binary.
#
# v0.4 adds (over v0.3):
#   - AND version specifier lists: pkg@'>=0.2.0,<0.3.0'
#     (every comma-separated constraint must hold; same syntax
#     as pip's comma list / npm's space-separated AND)
#   - '*' documented + accepted as an explicit any-version spec
#   - `catpm install` now honors an existing catpm.lock: installs
#     EXACTLY the locked versions (lock-exact restore, like
#     `npm ci` / `pip install` with a lock) and rewrites nothing;
#     `catpm update` re-resolves from catpm.json and rewrites the
#     lock (like `npm update`)
#   - upgrade/downgrade no longer leaves stale files: deps/<name>/
#     is wiped before each (re)install
#   - `catpm outdated`: show current vs newest version per package
#   - version engine unit tests extended to 44 assertions
#
# v0.3 (unchanged):
#   - package.where source list (apt sources.list style):
#       <source> [prio=N] [pkg=name1,name2]
#     multiple sources, priority-ordered downloads, per-source
#     package pinning, union version candidates across sources,
#     per-source fallback on download failure.
#     lookup chain: CATPM_WHERE -> ./package.where ->
#       <catpm binary dir>/package.where (up 2 levels) ->
#       legacy CATPM_REGISTRY / ./registry fallback
#   - `catpm sources` command: show configured sources + status
#
# v0.2 (unchanged):
#   - version specifiers: pkg@1.2.3 / ^1.2 / ~1.2 / >=1.0 / <2.0 /
#     >x / <=x / latest  (resolved + locked per PROTOCOL.md layer 2)
#   - `catpm lock` / `catpm pack` / `catpm publish`
#   - download cache + sha256 verification (sha256sum via exec)
#
# project layout managed:
#   catpm.json   manifest {"name","catpm","deps":{name:spec}}
#   catpm.lock   resolved pins (protocol layer 2)
#   deps/<name>/index.catc   vendored package sources
#   .catpm-cache/<name>/<name>-<ver>.cpkg   download cache
#
# usage: catpm <command> [args]
#   init / add <pkg[@spec]> / install / update / lock / list /
#   remove / outdated / pack / publish <registry-dir> / sources /
#   --version
# ============================================================

import ./util.catc as util
import ./ver.catc as ver

CATPM_VERSION: str = "0.4.0"

import ./util.catc as util
import ./ver.catc as ver

MANIFEST: str = "catpm.json"
LOCKFILE: str = "catpm.lock"
DEPSDIR: str = "deps"
CACHEDIR: str = ".catpm-cache"
WHEREFILE: str = "package.where"

def main(args: list[str]) {
    if len(args) < 1 {
        usage()
        return
    }
    cmd: str = args[0]
    if cmd == "init" {
        cmd_init()
    } else if cmd == "add" {
        if len(args) < 2 {
            print("catpm: 'add' needs a package, e.g. add mathx or add mathx@^1.2.0")
            return
        }
        cmd_add(args[1])
    } else if cmd == "install" {
        cmd_install()
    } else if cmd == "update" {
        cmd_update()
    } else if cmd == "outdated" {
        cmd_outdated()
    } else if cmd == "lock" {
        cmd_lock()
    } else if cmd == "list" {
        cmd_list()
    } else if cmd == "remove" {
        if len(args) < 2 {
            print("catpm: 'remove' needs a package name")
            return
        }
        cmd_remove(args[1])
    } else if cmd == "pack" {
        cmd_pack()
    } else if cmd == "publish" {
        if len(args) < 2 {
            print("catpm: 'publish' needs a target registry directory")
            return
        }
        cmd_publish(args[1])
    } else if cmd == "sources" {
        cmd_sources()
    } else if cmd == "--version" {
        print("catpm " + CATPM_VERSION + " (for CatBase 0.1.8)")
    } else {
        print("catpm: unknown command '" + cmd + "'")
        usage()
    }
}

def usage() {
    print("usage: catpm <command> [args]")
    print("  init                   create " + MANIFEST + " in the current directory")
    print("  add <pkg[@spec]>       add dependency (spec: 1.2.3 ^1.2 ~1.2 >=1,<2 * latest)")
    print("  install                install exactly what " + LOCKFILE + " pins (or resolve fresh)")
    print("  update                 re-resolve from " + MANIFEST + " and rewrite " + LOCKFILE)
    print("  outdated               show current vs newest version per package")
    print("  lock                   resolve + write " + LOCKFILE + " without installing")
    print("  list                   list installed packages and versions")
    print("  remove <name>          remove a direct dependency and prune orphans")
    print("  pack                   pack cwd package -> dist/<name>-<ver>.cpkg")
    print("  publish <registry-dir> publish dist/*.cpkg into a local registry")
    print("  sources                show configured sources (" + WHEREFILE + ")")
    print("  --version              show catpm version")
    print("sources: " + WHEREFILE + " (./ or next to the catpm binary; or CATPM_WHERE=<path>)")
    print("  line format: <dir|URL> [prio=N] [pkg=name1,name2]   (apt sources.list style)")
    print("  without " + WHEREFILE + ": CATPM_REGISTRY=<dir|URL>  (default ./registry)")
}

# ============================================================
# package.where — source list (protocol layer 4, see PROTOCOL.md 4.5)
# ============================================================
# state dict returned by load_sources():
#   "where"  str    path of the where-file used ("" = legacy fallback)
#   "roots"  list[str]  sources in download order (prio desc, stable)
#   "prio"   dict[str,any]  root -> int priority
#   "pkgs"   dict[str,any]  root -> csv pin ("" = serves every package)
# after fetch_all(st) also:
#   "idxs"   dict[str,any]  root -> parsed index.json
#   "ok"     list[str]     reachable roots (same order as roots)
#   "warn"   list[str]      warnings collected while fetching

def self_bindir() -> str {
    d: str = exec("dirname $(readlink -f /proc/$PPID/exe)")
    return d.strip()
}

def find_where() -> list[str] {
    out: list[str] = []
    env: str = getenv("CATPM_WHERE")
    if env != "" {
        if not file_exists(env) {
            print("catpm: CATPM_WHERE=" + env + " but that file does not exist")
            exit_now(1)
        }
        out.append(env)
        return out
    }
    if file_exists("./" + WHEREFILE) {
        out.append("./" + WHEREFILE)
        return out
    }
    bd: str = self_bindir()
    cands: list[str] = []
    cands.append(bd + "/" + WHEREFILE)
    cands.append(bd + "/../" + WHEREFILE)
    cands.append(bd + "/../../" + WHEREFILE)
    i: int = 0
    while i < len(cands) {
        if file_exists(cands[i]) {
            out.append(cands[i])
            return out
        }
        i = i + 1
    }
    return out
}

def all_digits(s: str) -> bool {
    if len(s) == 0 {
        return False
    }
    i: int = 0
    while i < len(s) {
        if not ver.is_digit(s[i:i+1]) {
            return False
        }
        i = i + 1
    }
    return True
}

# does list[str] contain r?
def roots_has(lst: list[str], r: str) -> bool {
    i: int = 0
    while i < len(lst) {
        if lst[i] == r {
            return True
        }
        i = i + 1
    }
    return False
}

def valid_source_addr(root: str) -> bool {
    if root.startswith("http://") {
        return True
    }
    if root.startswith("https://") {
        return True
    }
    if root[0:1] == "/" {
        return True
    }
    if root.startswith("./") {
        return True
    }
    if root.startswith("../") {
        return True
    }
    return False
}

def parse_where(path: str) -> dict[str, any] {
    st: dict[str, any] = {}
    st.put("where", path)
    roots: list[str] = []
    prio: dict[str, any] = {}
    pkgs: dict[str, any] = {}
    seen: dict[str, any] = {}
    f: File = file(path, "r")
    content: str = f.read()
    f.close()
    lines: list[str] = content.split("\n")
    i: int = 0
    while i < len(lines) {
        t: str = lines[i].replace("\t", " ")
        u: str = t.replace("\r", " ")
        ln: str = u.strip()
        if ln != "" {
            if ln[0:1] != "#" {
                toks: list[str] = util.toks(ln)
                root: str = toks[0]
                lno: str = str(i + 1)
                if not valid_source_addr(root) {
                    print("catpm: " + WHEREFILE + ":" + lno + ": source must start with / ./ ../ http:// or https:// — got '" + root + "'")
                    exit_now(1)
                }
                p: int = 0
                pin: str = ""
                j: int = 1
                while j < len(toks) {
                    tok: str = toks[j]
                    if tok.startswith("prio=") {
                        pvstr: str = tok[5:len(tok)]
                        if not all_digits(pvstr) {
                            print("catpm: " + WHEREFILE + ":" + lno + ": prio must be a non-negative integer — got '" + pvstr + "'")
                            exit_now(1)
                        }
                        p = int(pvstr)
                    } else if tok.startswith("pkg=") {
                        pin = tok[4:len(tok)]
                    } else {
                        print("catpm: " + WHEREFILE + ":" + lno + ": unknown option '" + tok + "' (expected prio=N or pkg=a,b)")
                        exit_now(1)
                    }
                    j = j + 1
                }
                if seen.contains(root) {
                    print("catpm: warning: " + WHEREFILE + ":" + lno + ": duplicate source '" + root + "' ignored")
                } else {
                    seen.put(root, 1)
                    roots.append(root)
                    prio.put(root, p)
                    pkgs.put(root, pin)
                }
            }
        }
        i = i + 1
    }
    if len(roots) == 0 {
        print("catpm: " + WHEREFILE + " has no source lines: " + path)
        print("  a line looks like:  <dir-or-URL>  [prio=N] [pkg=a,b]   (see PROTOCOL.md)")
        exit_now(1)
    }
    st.put("roots", roots)
    st.put("prio", prio)
    st.put("pkgs", pkgs)
    # stable sort by prio desc (insertion sort on parallel arrays)
    pv: list[int] = []
    i2: int = 0
    while i2 < len(roots) {
        pva: any = prio.get(str(roots[i2]), 0)
        pv.append(int(pva))
        i2 = i2 + 1
    }
    a: int = 1
    while a < len(roots) {
        key: str = roots[a]
        keyp: int = pv[a]
        b: int = a - 1
        moved: bool = True
        while b >= 0 and moved {
            prevp: int = pv[b]
            if prevp < keyp {
                roots[b + 1] = roots[b]
                pv[b + 1] = pv[b]
                b = b - 1
            } else {
                moved = False
            }
        }
        roots[b + 1] = key
        pv[b + 1] = keyp
        a = a + 1
    }
    return st
}

# legacy v0.2 fallback: single implicit source, no where-file
def implicit_state() -> dict[str, any] {
    st: dict[str, any] = {}
    st.put("where", "")
    root: str = getenv("CATPM_REGISTRY")
    if root == "" {
        root = "registry"
    }
    roots: list[str] = []
    roots.append(root)
    prio: dict[str, any] = {}
    prio.put(root, 0)
    pkgs: dict[str, any] = {}
    pkgs.put(root, "")
    st.put("roots", roots)
    st.put("prio", prio)
    st.put("pkgs", pkgs)
    return st
}

def load_sources() -> dict[str, any] {
    found: list[str] = find_where()
    st: dict[str, any] = {}
    if len(found) > 0 {
        st = parse_where(found[0])
        if getenv("CATPM_REGISTRY") != "" {
            print("catpm: note: ignoring CATPM_REGISTRY (" + WHEREFILE + " found: " + found[0] + ")")
        }
    } else {
        st = implicit_state()
    }
    return st
}

def kind_of(root: str) -> str {
    if root.startswith("http://") or root.startswith("https://") {
        return "url"
    }
    return "dir"
}

# fetch index.json from every source; unreachable ones warn + skip
def fetch_all(st: dict[str, any]) {
    idxs: dict[str, any] = {}
    ok: list[str] = []
    warns: list[str] = []
    rav: any = st.get("roots", None)
    roots: list[str] = rav
    i: int = 0
    while i < len(roots) {
        r: str = str(roots[i])
        if kind_of(r) == "url" {
            body: str = http_fetch_soft(r + "/index.json")
            if body == "" {
                warns.append("source unreachable: " + r)
            } else {
                b: str = body.strip()
                if not b.startswith("{") {
                    warns.append("invalid index at " + r + " (not a JSON object)")
                } else {
                    idxs.put(r, json_loads(b))
                    ok.append(r)
                }
            }
        } else {
            p: str = r + "/index.json"
            if not file_exists(p) {
                warns.append("source unreachable: " + r + " (no index.json)")
            } else {
                f: File = file(p, "r")
                c: str = f.read()
                f.close()
                cs: str = c.strip()
                if not cs.startswith("{") {
                    warns.append("invalid index at " + r + " (not a JSON object)")
                } else {
                    idxs.put(r, json_loads(cs))
                    ok.append(r)
                }
            }
        }
        i = i + 1
    }
    j: int = 0
    while j < len(warns) {
        print("catpm: warning: " + warns[j])
        j = j + 1
    }
    if len(ok) == 0 {
        print("catpm: no reachable source (all failed; see warnings above)")
        exit_now(1)
    }
    st.put("idxs", idxs)
    st.put("ok", ok)
    st.put("warn", warns)
}

def source_summary(st: dict[str, any]) -> str {
    rav: any = st.get("roots", None)
    roots: list[str] = rav
    out: str = ""
    i: int = 0
    while i < len(roots) {
        if i > 0 {
            out = out + ", "
        }
        out = out + str(roots[i])
        i = i + 1
    }
    if len(roots) > 1 {
        out = str(len(roots)) + " source(s): " + out
    }
    return out
}

def where_path_of(st: dict[str, any]) -> str {
    return str(st.get("where", ""))
}

# ---------- merged multi-source view (pin-filtered) ----------
# returns: dict version -> list[str] roots having that version, in prio order

def merged_versions(st: dict[str, any], name: str) -> dict[str, any] {
    out: dict[str, any] = {}
    ia: any = st.get("idxs", None)
    idxs: dict[str, any] = ia
    oa: any = st.get("ok", None)
    ok: list[str] = oa
    pa: any = st.get("pkgs", None)
    pkgs: dict[str, any] = pa
    i: int = 0
    while i < len(ok) {
        r: str = ok[i]
        pin: str = str(pkgs.get(r, ""))
        if pin != "" {
            if not util.csv_has(pin, name) {
                i = i + 1
                continue
            }
        }
        iv: any = idxs.get(r, None)
        if iv is None {
            i = i + 1
            continue
        }
        idxd: dict[str, any] = iv
        vs: dict[str, any] = index_versions(idxd, name)
        vks: list[str] = vs.keys()
        j: int = 0
        while j < len(vks) {
            v: str = vks[j]
            if out.contains(v) {
                cv: any = out.get(v, None)
                cur: list[str] = cv
                cur.append(r)
                out.put(v, cur)
            } else {
                nl: list[str] = []
                nl.append(r)
                out.put(v, nl)
            }
            j = j + 1
        }
        i = i + 1
    }
    return out
}

def merged_searched(st: dict[str, any]) -> str {
    oa: any = st.get("ok", None)
    ok: list[str] = oa
    out: str = ""
    i: int = 0
    while i < len(ok) {
        if i > 0 {
            out = out + ", "
        }
        out = out + ok[i]
        i = i + 1
    }
    return out
}

# ---------- shell helpers (exec captures stdout) ----------
# exec(cmd) always exits 0 in the parent; a failing child is signalled by
# writing its rc to /tmp/catpm_rc from within the sh script itself.

def sh_rc(cmdline: str) -> int {
    rcfile: str = "/tmp/catpm_rc"
    if file_exists(rcfile) {
        delete_file(rcfile)
    }
    inner: str = cmdline.replace("'", "'\\''")
    full: str = "sh -c '" + inner + " > /dev/null 2>&1'; rcode=$?; if [ $rcode -ne 0 ]; then echo $rcode > " + rcfile + "; fi"
    exec(full)
    if file_exists(rcfile) {
        f: File = file(rcfile, "r")
        c: str = f.read().strip()
        f.close()
        delete_file(rcfile)
        return int(c)
    }
    return 0
}

# run a shell command; on nonzero exit print stderr and die
def sh_die(cmdline: str, what: str) {
    tmp: str = "/tmp/catpm_sh_err"
    rcfile: str = "/tmp/catpm_rc"
    if file_exists(rcfile) {
        delete_file(rcfile)
    }
    inner: str = cmdline.replace("'", "'\\''")
    full: str = "sh -c '" + inner + " > " + tmp + " 2>&1'; rcode=$?; if [ $rcode -ne 0 ]; then echo $rcode > " + rcfile + "; fi"
    exec(full)
    if file_exists(rcfile) {
        f: File = file(rcfile, "r")
        c: str = f.read().strip()
        f.close()
        delete_file(rcfile)
        errtxt: str = ""
        if file_exists(tmp) {
            errf: File = file(tmp, "r")
            errtxt = errf.read().strip()
            errf.close()
            delete_file(tmp)
        }
        print("catpm: " + what + " failed (exit " + c + ")")
        if errtxt != "" {
            print("  " + errtxt)
        }
        exit_now(1)
    }
    if file_exists(tmp) {
        delete_file(tmp)
    }
}

# ---------- http fetch (curl via exec; builtin https is plaintext, probe p22) ----------

def http_fetch_soft(url: str) -> str {
    tmp: str = "/tmp/catpm_fetch_body"
    rc: int = sh_rc("curl -sS --max-time 60 -f -L -o " + tmp + " '" + url + "'")
    if rc != 0 {
        return ""
    }
    if not file_exists(tmp) {
        return ""
    }
    f: File = file(tmp, "r")
    body: str = f.read()
    f.close()
    delete_file(tmp)
    return body
}

def http_download_soft(url: str, dst: str) -> int {
    return sh_rc("curl -sS --max-time 300 -f -L -o '" + dst + "' '" + url + "'")
}

# ---------- sha256 (sha256sum via exec) ----------

def sha256_of(path: str) -> str {
    out: str = exec("sha256sum '" + path + "'")
    # "hex  path"
    sp: int = out.find(" ")
    if sp < 0 {
        print("catpm: cannot hash " + path)
        exit_now(1)
    }
    return out[0:sp]
}

# ---------- manifest (protocol layer 1) ----------

def manifest_exists() -> bool {
    return file_exists(MANIFEST)
}

def read_manifest() -> dict[str, any] {
    f: File = file(MANIFEST, "r")
    content: str = f.read()
    f.close()
    return json_loads(content)
}

def write_manifest(m: dict[str, any]) {
    f: File = file(MANIFEST, "w")
    f.write(json_dumps(m))
    f.write("\n")
    f.close()
}

def empty_manifest() -> dict[str, any] {
    m: dict[str, any] = {}
    m.put("name", "my-project")
    m.put("catpm", CATPM_VERSION)
    m.put("deps", {})
    return m
}

def manifest_pkg_name(m: dict[str, any]) -> str {
    return util.get_str(m, "name", "my-project")
}

def manifest_version(m: dict[str, any]) -> str {
    return util.get_str(m, "version", "0.1.0")
}

# ---------- single index access (same schema at every source) ----------
# index.json format (identical for local dir and remote URL sources):
#   {"packages": {"<name>": {"<version>": {"path": "<rel>", "sha256": "<hex>"}}}}

def index_versions(idx: dict[str, any], name: str) -> dict[str, any] {
    pkgs: dict[str, any] = util.get_dict(idx, "packages")
    if not pkgs.contains(name) {
        return {}
    }
    return util.get_dict(pkgs, name)
}

def index_list_versions(idx: dict[str, any], name: str) -> list[str] {
    vs: dict[str, any] = index_versions(idx, name)
    return vs.keys()
}

# entry: {"path":..,"sha256":..} or {}
def index_entry(idx: dict[str, any], name: str, v: str) -> dict[str, any] {
    vs: dict[str, any] = index_versions(idx, name)
    if not vs.contains(v) {
        return {}
    }
    return util.get_dict(vs, v)
}

# ---------- resolution (protocol layer 2) ----------
# BFS over the merged multi-source view; each package name resolved once,
# FIRST WINS. Candidates = union of versions across all (pin-allowed) sources.

def resolve_all(direct: dict[str, str], resolved: dict[str, str], order: list[str], st: dict[str, any]) -> list[str] {
    warnings: list[str] = []
    queue: list[str] = []
    ks: list[str] = direct.keys()
    i: int = 0
    while i < len(ks) {
        resolved.put(ks[i], direct[ks[i]])
        queue.append(ks[i])
        i = i + 1
    }
    qi: int = 0
    while qi < len(queue) {
        name: str = queue[qi]
        qi = qi + 1
        spec: str = resolved[name]
        vers: dict[str, any] = merged_versions(st, name)
        cands: list[str] = vers.keys()
        if len(cands) == 0 {
            print("catpm: package not found in any source: " + name)
            print("  searched: " + merged_searched(st))
            exit_now(1)
        }
        bestv: str = ver.best_match(cands, spec)
        if bestv == "" {
            print("catpm: no version of " + name + " satisfies '" + spec + "' (available: " + join_versions(cands) + ")")
            exit_now(1)
        }
        resolved.put(name, bestv)
        order.append(name + "@" + bestv)
        # transitive deps: from the entry at the first source that has name@bestv
        rav: any = vers.get(bestv, None)
        roots_any: list[str] = rav
        ia: any = st.get("idxs", None)
        idxs: dict[str, any] = ia
        ent: dict[str, any] = {}
        if roots_any is None {
            ent = {}
        } else {
            # index_entry against a single index; rebuild from first root
            iv: any = idxs.get(roots_any[0], None)
            if iv is None {
                ent = {}
            } else {
                idxd: dict[str, any] = iv
                ent = index_entry(idxd, name, bestv)
            }
        }
        deps: dict[str, any] = util.get_dict(ent, "deps")
        dk: list[str] = deps.keys()
        j: int = 0
        while j < len(dk) {
            depname: str = dk[j]
            depver: str = util.get_str(deps, depname, "latest")
            if resolved.contains(depname) {
                have: str = resolved[depname]
                if not ver.satisfies(have, depver) {
                    warnings.append(depname + ": " + name + " wants " + depver + ", keeping " + have)
                }
            } else {
                resolved.put(depname, depver)
                queue.append(depname)
            }
            j = j + 1
        }
    }
    return warnings
}

def join_versions(vs: list[str]) -> str {
    out: str = ""
    i: int = 0
    while i < len(vs) {
        if i > 0 {
            out = out + " "
        }
        out = out + vs[i]
        i = i + 1
    }
    return out
}

# ---------- install (protocol layer 3+4: fetch cpkg, verify, unpack) ----------
# tries the sources that have name@version in priority order; a source that
# fails (missing file / download error) is skipped with a notice.

def install_one(st: dict[str, any], name: str, version: str) {
    ia: any = st.get("idxs", None)
    idxs: dict[str, any] = ia
    vers: dict[str, any] = merged_versions(st, name)
    if not vers.contains(version) {
        print("catpm: " + name + "@" + version + " not found in any source")
        print("  searched: " + merged_searched(st))
        exit_now(1)
    }
    rv: any = vers.get(version, None)
    roots_any: list[str] = rv
    rel: str = ""
    want_sha: str = ""
    gotit: bool = False
    # cache path
    cdir: str = CACHEDIR + "/" + name
    mkdir(CACHEDIR)
    mkdir(cdir)
    cpkg: str = cdir + "/" + name + "-" + version + ".cpkg"
    k: int = 0
    while k < len(roots_any) {
        r: str = roots_any[k]
        iv: any = idxs.get(r, None)
        if iv is None {
            k = k + 1
            continue
        }
        idxd: dict[str, any] = iv
        ent: dict[str, any] = index_entry(idxd, name, version)
        rel = util.get_str(ent, "path", "")
        want_sha = util.get_str(ent, "sha256", "")
        if rel == "" {
            print("  source " + r + " has no path for " + name + "@" + version + ", trying next")
            k = k + 1
            continue
        }
        if not file_exists(cpkg) {
            if kind_of(r) == "url" {
                url: str = r + "/" + rel
                print("  downloading " + name + "@" + version + " <- " + url)
                rc: int = http_download_soft(url, cpkg)
                if rc != 0 {
                    print("  source " + r + " failed (curl exit " + str(rc) + "), trying next")
                    if file_exists(cpkg) {
                        delete_file(cpkg)
                    }
                    k = k + 1
                    continue
                }
            } else {
                src: str = r + "/" + rel
                if not file_exists(src) {
                    print("  source " + r + " missing file " + src + ", trying next")
                    k = k + 1
                    continue
                }
                print("  copying " + name + "@" + version + " <- " + src)
                copy_file(src, cpkg)
            }
        } else {
            print("  cached " + cpkg)
        }
        gotit = True
        break
    }
    if not gotit {
        print("catpm: all sources failed to provide " + name + "@" + version)
        exit_now(1)
    }
    got: str = sha256_of(cpkg)
    if want_sha != "" and got != want_sha {
        print("catpm: sha256 MISMATCH for " + cpkg)
        print("  index:  " + want_sha)
        print("  actual: " + got)
        exit_now(1)
    }
    # unpack into deps/<name>/  (tar.gz made by pack: index.catc + catpm.json at root)
    # wipe any previous install first: an upgrade must not leave stale files
    dst: str = DEPSDIR + "/" + name
    mkdir(DEPSDIR)
    if isdir(dst) {
        sh_die("rm -rf '" + dst + "'", "clean " + dst)
    }
    mkdir(dst)
    sh_die("tar -xzf '" + cpkg + "' -C '" + dst + "'", "unpack " + cpkg)
    if not file_exists(dst + "/index.catc") {
        print("catpm: package " + name + "@" + version + " has no index.catc after unpack")
        exit_now(1)
    }
    print("  installed " + name + "@" + version + " (sha256 ok) -> " + dst + "/index.catc")
}

def copy_file(src: str, dst: str) {
    f: File = file(src, "r")
    body: str = f.read()
    f.close()
    o: File = file(dst, "w")
    o.write(body)
    o.close()
}

def write_lock(order: list[str], warnings: list[str]) {
    f: File = file(LOCKFILE, "w")
    f.write("# catpm lock file v2 (generated, do not edit)\n")
    f.write("# format: name version\n")
    i: int = 0
    while i < len(order) {
        pair: list[str] = order[i].split("@")
        f.write(pair[0] + " " + pair[1] + "\n")
        i = i + 1
    }
    if len(warnings) > 0 {
        f.write("# conflicts:\n")
        j: int = 0
        while j < len(warnings) {
            f.write("# " + warnings[j] + "\n")
            j = j + 1
        }
    }
    f.close()
}

def read_lock() -> dict[str, str] {
    out: dict[str, str] = {}
    if not file_exists(LOCKFILE) {
        return out
    }
    f: File = file(LOCKFILE, "r")
    content: str = f.read()
    f.close()
    lines: list[str] = content.split("\n")
    i: int = 0
    while i < len(lines) {
        ln: str = lines[i].strip()
        if ln != "" {
            if ln[0] != "#" {
                parts: list[str] = ln.split(" ")
                if len(parts) >= 2 {
                    out.put(parts[0], parts[1])
                }
            }
        }
        i = i + 1
    }
    return out
}

# ---------- commands ----------

def cmd_init() {
    if manifest_exists() {
        print("catpm: " + MANIFEST + " already exists here")
        return
    }
    write_manifest(empty_manifest())
    print("catpm: created " + MANIFEST)
    print("  add deps with: catpm add <name>[@spec]")
}

def cmd_add(spec_str: str) {
    if not manifest_exists() {
        print("catpm: no " + MANIFEST + " here; run 'catpm init' first")
        exit_now(1)
    }
    parts: list[str] = ver.split_pkg(spec_str)
    name: str = parts[0]
    spec: str = parts[1]
    # validate against the sources BEFORE touching the manifest
    st: dict[str, any] = load_sources()
    fetch_all(st)
    vers: dict[str, any] = merged_versions(st, name)
    cands: list[str] = vers.keys()
    if len(cands) == 0 {
        print("catpm: package not found in any source: " + name)
        print("  searched: " + merged_searched(st))
        exit_now(1)
    }
    bestv: str = ver.best_match(cands, spec)
    if bestv == "" {
        print("catpm: no version of " + name + " satisfies '" + spec + "' (available: " + join_versions(cands) + ")")
        exit_now(1)
    }
    m: dict[str, any] = read_manifest()
    deps: dict[str, any] = util.get_dict(m, "deps")
    deps.put(name, spec)
    m.put("deps", deps)
    write_manifest(m)
    print("catpm: added " + name + " '" + spec + "' to " + MANIFEST + " (resolves to " + bestv + ")")
    do_install()
}

def cmd_install() {
    if not manifest_exists() {
        print("catpm: no " + MANIFEST + " here; run 'catpm init' first")
        exit_now(1)
    }
    # lock-exact restore (like `npm ci`): if a lock exists and covers every
    # manifest dep, install EXACTLY the locked versions — no re-resolution.
    lock: dict[str, str] = read_lock()
    direct: dict[str, str] = manifest_direct_deps()
    usable: bool = file_exists(LOCKFILE) and len(lock) > 0
    if usable {
        dk: list[str] = direct.keys()
        i: int = 0
        while i < len(dk) {
            if not lock.contains(dk[i]) {
                usable = False
            }
            i = i + 1
        }
    }
    if usable {
        install_from_lock(lock)
        return
    }
    do_install()
}

# install exactly the pins in the lock file (no resolver involved)
def install_from_lock(lock: dict[str, str]) {
    st: dict[str, any] = load_sources()
    fetch_all(st)
    print("catpm: installing exactly from " + LOCKFILE + " (lock-exact; no re-resolution)")
    names: list[str] = lock.keys()
    # deterministic order: sort by name
    i: int = 1
    while i < len(names) {
        key: str = names[i]
        j: int = i - 1
        while j >= 0 and util.str_greater(names[j], key) {
            names[j + 1] = names[j]
            j = j - 1
        }
        names[j + 1] = key
        i = i + 1
    }
    k: int = 0
    while k < len(names) {
        install_one(st, names[k], lock[names[k]])
        k = k + 1
    }
    # anything in deps/ not covered by the lock is stale -> prune
    prune()
    print("catpm: lock restore complete (" + str(len(names)) + " package(s))")
}

def cmd_update() {
    if not manifest_exists() {
        print("catpm: no " + MANIFEST + " here; run 'catpm init' first")
        exit_now(1)
    }
    print("catpm: updating (re-resolving " + MANIFEST + " from sources)")
    do_install()
}

def cmd_outdated() {
    if not manifest_exists() {
        print("catpm: no " + MANIFEST + " here; run 'catpm init' first")
        exit_now(1)
    }
    lock: dict[str, str] = read_lock()
    if len(lock) == 0 {
        print("catpm: no " + LOCKFILE + " yet (run catpm install or catpm lock first)")
        exit_now(1)
    }
    st: dict[str, any] = load_sources()
    fetch_all(st)
    print("  package   current   newest")
    names: list[str] = lock.keys()
    i: int = 1
    while i < len(names) {
        key: str = names[i]
        j: int = i - 1
        while j >= 0 and util.str_greater(names[j], key) {
            names[j + 1] = names[j]
            j = j - 1
        }
        names[j + 1] = key
        i = i + 1
    }
    found: int = 0
    k: int = 0
    while k < len(names) {
        n: str = names[k]
        vers: dict[str, any] = merged_versions(st, n)
        cands: list[str] = vers.keys()
        newest: str = ver.best_match(cands, "*")
        cur: str = lock[n]
        mark: str = ""
        if newest != "" {
            if ver.vcmp(newest, cur) > 0 {
                mark = "  -> upgradable"
                found = found + 1
            }
        }
        print("  " + util.pad(n, 10) + util.pad(cur, 10) + newest + mark)
        k = k + 1
    }
    if found == 0 {
        print("  (all up to date)")
    }
}

def cmd_lock() {
    if not manifest_exists() {
        print("catpm: no " + MANIFEST + " here; run 'catpm init' first")
        exit_now(1)
    }
    direct: dict[str, str] = manifest_direct_deps()
    if len(direct) == 0 {
        print("catpm: no dependencies in " + MANIFEST)
        exit_now(1)
    }
    st: dict[str, any] = load_sources()
    fetch_all(st)
    print("catpm: resolving (source: " + source_summary(st) + ")")
    resolved: dict[str, str] = {}
    order: list[str] = []
    warnings: list[str] = resolve_all(direct, resolved, order, st)
    write_lock(order, warnings)
    print("catpm: wrote " + LOCKFILE + ":")
    i: int = 0
    while i < len(order) {
        print("  - " + order[i])
        i = i + 1
    }
    j: int = 0
    while j < len(warnings) {
        print("  ! conflict " + warnings[j])
        j = j + 1
    }
}

def manifest_direct_deps() -> dict[str, str] {
    m: dict[str, any] = read_manifest()
    direct_any: dict[str, any] = util.get_dict(m, "deps")
    direct: dict[str, str] = {}
    dk: list[str] = direct_any.keys()
    i: int = 0
    while i < len(dk) {
        direct.put(dk[i], util.get_str(direct_any, dk[i], "latest"))
        i = i + 1
    }
    return direct
}

def do_install() {
    direct: dict[str, str] = manifest_direct_deps()
    if len(direct) == 0 {
        print("catpm: no dependencies in " + MANIFEST + " (writing empty lock, pruning)")
        f: File = file(LOCKFILE, "w")
        f.write("# catpm lock file v2 (generated, do not edit)\n")
        f.write("# format: name version\n")
        f.close()
        prune()
        return
    }
    st: dict[str, any] = load_sources()
    fetch_all(st)
    print("catpm: resolving dependencies (source: " + source_summary(st) + ")")
    resolved: dict[str, str] = {}
    order: list[str] = []
    warnings: list[str] = resolve_all(direct, resolved, order, st)
    print("catpm: resolved " + str(len(order)) + " package(s):")
    j: int = 0
    while j < len(order) {
        print("  - " + order[j])
        j = j + 1
    }
    k: int = 0
    while k < len(warnings) {
        print("  ! conflict " + warnings[k])
        k = k + 1
    }
    print("catpm: installing into ./" + DEPSDIR + "/")
    j = 0
    while j < len(order) {
        pair: list[str] = order[j].split("@")
        install_one(st, pair[0], pair[1])
        j = j + 1
    }
    write_lock(order, warnings)
    print("catpm: wrote " + LOCKFILE)
}

def cmd_sources() {
    st: dict[str, any] = load_sources()
    w: str = where_path_of(st)
    if w == "" {
        print("catpm: no " + WHEREFILE + " found; implicit single source (CATPM_REGISTRY or ./registry)")
    } else {
        print("catpm: sources from " + w)
    }
    rav: any = st.get("roots", None)
    roots: list[str] = rav
    pa: any = st.get("prio", None)
    prio: dict[str, any] = pa
    ka: any = st.get("pkgs", None)
    pkgs: dict[str, any] = ka
    # reachability check
    fetch_all(st)
    oa: any = st.get("ok", None)
    ok: list[str] = oa
    print("  prio kind root                                        serves       status")
    i: int = 0
    while i < len(roots) {
        r: str = roots[i]
        pv: any = prio.get(r, 0)
        p: str = util.pad(str(int(pv)), 5) + " "
        kd: str = util.pad(kind_of(r), 4) + " "
        pin: str = str(pkgs.get(r, ""))
        if pin == "" {
            pin = "(all)"
        }
        status: str = "ok"
        if not roots_has(ok, r) {
            status = "UNREACHABLE"
        }
        print("  " + p + kd + util.pad(r, 43) + util.pad(pin, 12) + status)
        i = i + 1
    }
}

def cmd_list() {
    if not isdir(DEPSDIR) {
        print("catpm: no ./" + DEPSDIR + "/ directory (nothing installed)")
        return
    }
    lock: dict[str, str] = read_lock()
    names: list[str] = listdir(DEPSDIR)
    # insertion sort (no sorted() builtin in v0.1.8)
    i: int = 1
    while i < len(names) {
        key: str = names[i]
        j2: int = i - 1
        while j2 >= 0 and util.str_greater(names[j2], key) {
            names[j2 + 1] = names[j2]
            j2 = j2 - 1
        }
        names[j2 + 1] = key
        i = i + 1
    }
    print("installed packages in ./" + DEPSDIR + ":")
    i = 0
    while i < len(names) {
        n: str = names[i]
        if isdir(DEPSDIR + "/" + n) {
            v: str = lock.get(n, "?")
            tag: str = ""
            if v == "?" {
                tag = " (no lock entry)"
            }
            print("  " + n + "  " + v + tag)
        }
        i = i + 1
    }
}

def cmd_remove(name: str) {
    if not manifest_exists() {
        print("catpm: no " + MANIFEST + " here")
        exit_now(1)
    }
    m: dict[str, any] = read_manifest()
    deps: dict[str, any] = util.get_dict(m, "deps")
    if not deps.contains(name) {
        print("catpm: " + name + " is not a direct dependency")
        exit_now(1)
    }
    deps.remove(name)
    m.put("deps", deps)
    write_manifest(m)
    print("catpm: removed " + name + " from " + MANIFEST)
    do_install()
    prune()
}

# delete deps/<name> for packages not in the lock file
def prune() {
    lock: dict[str, str] = read_lock()
    if not isdir(DEPSDIR) {
        return
    }
    names: list[str] = listdir(DEPSDIR)
    i: int = 0
    while i < len(names) {
        n: str = names[i]
        if isdir(DEPSDIR + "/" + n) {
            if not lock.contains(n) {
                print("catpm: pruned " + DEPSDIR + "/" + n + " (no longer needed)")
                sh_die("rm -rf '" + DEPSDIR + "/" + n + "'", "prune " + n)
            }
        }
        i = i + 1
    }
}

# ---------- pack (protocol layer 3) ----------
# reads catpm.json in cwd; requires name+version; packs index.catc (+ any
# extra .catc files listed in "files") into dist/<name>-<ver>.cpkg (tar.gz)

def cmd_pack() {
    if not manifest_exists() {
        print("catpm: no " + MANIFEST + " here")
        exit_now(1)
    }
    m: dict[str, any] = read_manifest()
    name: str = manifest_pkg_name(m)
    version: str = manifest_version(m)
    if not ver.valid_version(version) {
        print("catpm: catpm.json needs a valid version (x.y.z), got '" + version + "'")
        exit_now(1)
    }
    if not file_exists("index.catc") {
        print("catpm: no ./index.catc here (a package is index.catc + catpm.json)")
        exit_now(1)
    }
    # staging dir: dist/stage-<name>-<ver>/
    stage: str = "dist/stage-" + name + "-" + version
    mkdir("dist")
    sh_die("rm -rf '" + stage + "'", "clean stage")
    mkdir(stage)
    copy_file("index.catc", stage + "/index.catc")
    copy_file(MANIFEST, stage + "/" + MANIFEST)
    # extra files from optional "files": [...] list
    files: list[any] = []
    if m.contains("files") {
        fv: any = m.get("files", None)
        files = fv
    }
    fi: int = 0
    while fi < len(files) {
        fn: str = str(files[fi])
        if not file_exists(fn) {
            print("catpm: extra file listed in catpm.json not found: " + fn)
            exit_now(1)
        }
        sh_die("mkdir -p '" + stage + "/" + parent_dir(fn) + "' && cp '" + fn + "' '" + stage + "/" + fn + "'", "copy " + fn)
        fi = fi + 1
    }
    out: str = "dist/" + name + "-" + version + ".cpkg"
    sh_die("tar -czf '" + out + "' -C '" + stage + "' index.catc " + MANIFEST + " $(cd '" + stage + "' && find . -mindepth 1 -not -name index.catc -not -name " + MANIFEST + " -not -path './dist*' | sed 's|^\\./||')", "pack tar")
    sh_die("rm -rf '" + stage + "'", "clean stage")
    sha: str = sha256_of(out)
    sz: int = file_size(out)
    print("catpm: packed " + name + "@" + version + " -> " + out)
    print("  size: " + str(sz) + " bytes   sha256: " + sha)
}

def parent_dir(p: str) -> str {
    i: int = p.rfind("/")
    if i < 0 {
        return "."
    }
    return p[0:i]
}

def file_size(p: str) -> int {
    st: dict[str, any] = file_stat(p)
    return int(st.get("size", 0))
}

# ---------- publish (local registry dir) ----------

def cmd_publish(regdir: str) {
    if not isdir(regdir) {
        print("catpm: registry directory not found: " + regdir)
        exit_now(1)
    }
    if not manifest_exists() {
        print("catpm: no " + MANIFEST + " here (run inside a package)")
        exit_now(1)
    }
    m: dict[str, any] = read_manifest()
    name: str = manifest_pkg_name(m)
    version: str = manifest_version(m)
    cpkg: str = "dist/" + name + "-" + version + ".cpkg"
    if not file_exists(cpkg) {
        print("catpm: " + cpkg + " not found; run 'catpm pack' first")
        exit_now(1)
    }
    sha: str = sha256_of(cpkg)
    # index.json update (or create)
    idx: dict[str, any] = {}
    ipath: str = regdir + "/index.json"
    if file_exists(ipath) {
        f: File = file(ipath, "r")
        idx = json_loads(f.read())
        f.close()
    } else {
        idx.put("packages", {})
    }
    pkgs: dict[str, any] = util.get_dict(idx, "packages")
    if not pkgs.contains(name) {
        pkgs.put(name, {})
    }
    vers: dict[str, any] = util.get_dict(pkgs, name)
    entry: dict[str, any] = {}
    entry.put("path", name + "/" + name + "-" + version + ".cpkg")
    entry.put("sha256", sha)
    # embed deps for layer-2 resolution without downloading the package
    deps: dict[str, any] = util.get_dict(m, "deps")
    entry.put("deps", deps)
    vers.put(version, entry)
    pkgs.put(name, vers)
    idx.put("packages", pkgs)
    # write index then copy package
    mkdir(regdir + "/" + name)
    copy_file(cpkg, regdir + "/" + name + "/" + name + "-" + version + ".cpkg")
    o: File = file(ipath, "w")
    o.write(json_dumps(idx))
    o.write("\n")
    o.close()
    print("catpm: published " + name + "@" + version)
    print("  -> " + regdir + "/" + name + "/" + name + "-" + version + ".cpkg")
    print("  -> " + ipath + " updated (sha256 " + sha[0:16] + "...)")
}

def exit_now(code: int) {
    exit(code)
}
